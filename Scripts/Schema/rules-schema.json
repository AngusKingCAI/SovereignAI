{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SovereignAI Rules File Schema",
  "description": "Schema for validating SovereignAI rules markdown files",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Rule set name"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Rule set description"
    },
    "status": {
      "type": "string",
      "enum": ["Active", "Template", "Draft", "Deprecated"],
      "description": "Rule set status"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Creation date in YYYY-MM-DD format"
    },
    "template_type": {
      "type": "string",
      "description": "Template type (for template files)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Version number"
    },
    "last_modified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Last modification date"
    },
    "agent_type": {
      "type": "string",
      "description": "Agent type (for agent-specific rules)"
    }
  },
  "required": ["name", "description", "status"],
  "additionalProperties": false
}