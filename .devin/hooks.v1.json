{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "Scripts/TokenOptimization/file_read_cache.bat SessionStart",
          "timeout": 30
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "^read$",
      "hooks": [
        {
          "type": "command",
          "command": "Scripts/TokenOptimization/file_read_cache.bat PreToolUse",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(read|edit|write)$",
      "hooks": [
        {
          "type": "command",
          "command": "Scripts/TokenOptimization/file_read_cache.bat PostToolUse",
          "timeout": 10
        }
      ]
    }
  ]
}