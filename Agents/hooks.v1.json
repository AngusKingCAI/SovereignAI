{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python Scripts/Gating/Hooks/session_init.py",
          "timeout": 30
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python Scripts/Gating/Hooks/workflow_step_gate.py",
          "timeout": 30
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python Scripts/Gating/Hooks/operation_logger.py",
          "timeout": 30
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python Scripts/Gating/Hooks/user_decision_handler.py",
          "timeout": 30
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python Scripts/Gating/Hooks/session_finalization.py",
          "timeout": 30
        }
      ]
    }
  ]
}
