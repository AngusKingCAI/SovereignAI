{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"Scripts/Rules/Enforcement/session_init.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "exec|write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"Scripts/Rules/Enforcement/evaluator.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"Scripts/Rules/Enforcement/evaluator.py\""
          }
        ]
      }
    ]
  }
}