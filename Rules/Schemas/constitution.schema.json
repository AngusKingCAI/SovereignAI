{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Constitution",
  "type": "object",
  "required": ["version", "updated", "purpose", "hierarchy", "principles"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver version of the constitution"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Last update date (YYYY-MM-DD)"
    },
    "purpose": {
      "type": "string",
      "description": "Purpose statement for the constitution"
    },
    "hierarchy": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["tier", "name", "description", "overrides"],
        "properties": {
          "tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "name": {
            "type": "string",
            "enum": ["safety", "ethics", "compliance", "helpfulness"]
          },
          "description": {
            "type": "string"
          },
          "overrides": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["safety", "ethics", "compliance", "helpfulness"]
            }
          }
        }
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "tier", "text", "enforceable_via"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3}$",
            "description": "Unique principle identifier"
          },
          "tier": {
            "type": "string",
            "enum": ["safety", "ethics", "compliance", "helpfulness"]
          },
          "text": {
            "type": "string",
            "description": "Principle statement"
          },
          "enforceable_via": {
            "type": "string",
            "enum": ["hook", "validator", "both", "prompt"],
            "description": "How this principle is enforced"
          }
        }
      }
    }
  }
}
