{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SovereignAI Rules File Schema",
  "description": "Schema for validating SovereignAI rules markdown files",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Rule set identifier"
    },
    "status": {
      "type": "string",
      "enum": ["active", "template", "draft", "deprecated"],
      "description": "Rule set status"
    },
    "owner": {
      "type": "string",
      "description": "Rule set owner (agent type)"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Last update date in YYYY-MM-DD format"
    },
    "purpose": {
      "type": "string",
      "minLength": 10,
      "description": "Rule set purpose"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Version number"
    }
  },
  "required": ["id", "status", "owner", "updated", "purpose"],
  "additionalProperties": false
}