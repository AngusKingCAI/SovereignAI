{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SovereignAI Template Document Schema",
  "description": "Schema for validating SovereignAI template markdown files",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Template identifier"
    },
    "status": {
      "type": "string",
      "enum": ["active", "archived", "draft"],
      "description": "Template status"
    },
    "owner": {
      "type": "string",
      "description": "Template owner"
    },
    "updated": {
      "type": ["string", "date"],
      "description": "Last update date (YYYY-MM-DD format)"
    },
    "purpose": {
      "type": "string",
      "minLength": 10,
      "description": "Template purpose"
    },
    "location": {
      "type": "string",
      "description": "Template file location (optional)"
    },
    "usage": {
      "type": "string",
      "description": "Template usage instructions (optional)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Template version (optional)"
    }
  },
  "required": ["id", "purpose"],
  "additionalProperties": false
}